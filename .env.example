# ─────────────────────────────────────────────────────────────────────────────
# Supabase — copy from your Supabase project Settings → API
# These are also what GitHub Actions uses at build time. Add identical values
# as GitHub repo Secrets with the same names.
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://lcnfnwivodzjjpykihfn.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Meta Pixel ID baked in at build time (optional — falls back to seoSettings.pixel_code)
VITE_META_PIXEL_ID=

# ─────────────────────────────────────────────────────────────────────────────
# The values below are NOT used by the React build. They live as
# Supabase Edge Function secrets (set in the Supabase dashboard → Functions → Secrets).
# Listed here for documentation only.
# ─────────────────────────────────────────────────────────────────────────────
# ADMIN_EMAIL=telzoncilentsbusiness@gmail.com
# META_PIXEL_ID=                  # numeric ID from Meta Events Manager
# META_CAPI_TOKEN=                # Conversions API access token
# META_TEST_EVENT_CODE=           # optional, for Test Events tab
# META_AD_ACCOUNT_ID=             # ad account, e.g. 1234567890 (with or without "act_" prefix)
# META_MARKETING_TOKEN=           # system-user token with ads_read scope
# RESEND_API_KEY=                 # Resend API key for lead-notification emails
# RESEND_FROM_EMAIL="Telzon Leads <leads@yourdomain.com>"

# ─────────────────────────────────────────────────────────────────────────────
# GitHub repo Secrets (used only by .github/workflows/deploy.yml)
# ─────────────────────────────────────────────────────────────────────────────
# FTP_SERVER=ftp.yourdomain.com
# FTP_USERNAME=u123456789.yourdomain
# FTP_PASSWORD=your_ftp_password
# FTP_SERVER_DIR=public_html/    # default Hostinger web root

# Optional: Google Indexing API service account (already wired via SEO scripts)
# GOOGLE_INDEXING_KEY={"type":"service_account",...}
